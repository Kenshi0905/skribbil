# Dockerfile-specific allowlist: never send local databases or secrets in build context.
**
!package.json
!package-lock.json
!server/
!server/**
!database/
!database/**
!scripts/
!scripts/**
!web/
!web/**
!infra/
!infra/start.sh
!engine/
!engine/**
engine/.git
engine/.env
engine/.env.*
engine/scribblers
engine/*.exe
engine/.data
engine/.data/**
engine/.tools
engine/.tools/**
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/.git
**/.git/**
