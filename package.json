{
  "name": "skribbil",
  "version": "0.2.0",
  "private": true,
  "description": "A cross-game community league built around the original scribble.rs engine",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check web/app.js",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@electric-sql/pglite": "^0.3.14",
    "@napi-rs/canvas": "^1.0.11",
    "pg": "^8.16.3"
  }
}
