# Copy to .env; Node 22+ can load with: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Omit DATABASE_URL to use local, durable embedded PostgreSQL in .data/postgres.
# DATABASE_URL=postgresql://skribbil:password@localhost:5432/skribbil
ENGINE_URL=http://127.0.0.1:8080
# Set the SAME random 32+ character secret on platform and engine.
SKRIBBIL_ENGINE_SECRET=
SKRIBBIL_EVENTS_URL=http://127.0.0.1:3000/api/internal/engine-events
# Required behind HTTPS in production.
COOKIE_SECURE=false
NODE_ENV=development

# Local dev launcher uses game port 4181 (Windows may reserve port 8080).
ENGINE_PORT=4181
# Leave false for the free-hosted pilot. Enable only for tested local ranked play.
SKRIBBIL_RANKED_ENABLED=false

# Hosted private object storage: use Supabase Free's S3-compatible endpoint.
# S3_ENDPOINT=https://PROJECT.storage.supabase.co/storage/v1/s3
# S3_REGION=YOUR_PROJECT_REGION
# S3_BUCKET=skribbil-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SKRIBBIL_ORIGIN_KEY=another-random-32-or-more-character-secret

