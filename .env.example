# Copy to .env; Node 22+ can load with: node --env-file=.env server/index.mjs
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Omit DATABASE_URL to use local, durable embedded PostgreSQL in .data/postgres.
# DATABASE_URL=postgresql://skribbil:password@localhost:5432/skribbil
ENGINE_URL=http://127.0.0.1:8080
# Set the SAME random 32+ character secret on platform and engine.
SKRIBBIL_ENGINE_SECRET=
SKRIBBIL_EVENTS_URL=http://127.0.0.1:3000/api/internal/engine-events
# Required behind HTTPS in production.
COOKIE_SECURE=false
NODE_ENV=development

